<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">


<mapper namespace="mybatis.mapper.userMapper">
    <select id="selectById" resultType="mybatis.pojo.user">
        select * from user
        <where>
            <if test="id!=null">
                id=#{id}
            </if>
        </where>
    </select>
</mapper>